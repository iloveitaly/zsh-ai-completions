_security_export_smartcard() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C -S \
    '1: :->token' \
    '*:: :->args' && return 0

  case $state in
    (token)
      local -a tokens
      tokens=('token:Export items from a smartcard token')
      _describe -t tokens 'token' tokens
      ;;
    (args)
      _arguments -S \
        '-i[ID of the smartcard to export]:id' \
        '-t[Type of items to export]:type:(certs privKeys identities all)' \
        '-e[Path to export certificates and public keys]:exportPath:_files'
      ;;
  esac
}

