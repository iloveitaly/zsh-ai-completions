_security_authorizationdb_commands() {
  local -a commands
  commands=(
    'read:Read a right definition from the database'
    'remove:Remove a right from the database'
    'write:Write a right definition to the database'
    'reset:Reset Authorization database to the default state'
  )
  _describe -t commands 'authorizationdb command' commands
}

_security_authorizationdb() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C -S \
    '1: :_security_authorizationdb_commands' \
    '*:: :->args' && return 0

  case $state in
    (args)
      case $words[1] in
        (read)
          _arguments -S \
            '1:right-name'
          ;;
        (remove)
          _arguments -S \
            '1:right-name'
          ;;
        (write)
          _arguments -S \
            '1:right-name' \
            '2:rule:(allow deny)'
          ;;
        (reset)
          _arguments -S \
            '1:data volume UUID'
          ;;
      esac
      ;;
  esac
}

_security_execute_with_privileges() {
  _arguments -S \
    '1:program:_files -g "*(*)"' \
    '*:args:_files'
}

_security_leaks() {
  _arguments -S \
    '-cycles[Use a stricter algorithm]' \
    '-nocontext[Withhold hex dumps of the leaked memory]' \
    '-nostacks[Do not show stack traces of leaked memory]' \
    '-exclude[Ignore leaks called from symbol]:symbol'
}

_security_error() {
  _arguments -S \
    '*:error-code'
}

_security_create_filevaultmaster_keychain() {
  _arguments -S \
    '-p[Use password for the keychain being created (insecure)]:password' \
    '-s[Keysize in bits (default 2048; 1024 and 4096 allowed)]:size:(1024 2048 4096)' \
    '1:keychain name:_security_keychains'
}

_security_smartcards_token_commands() {
  # token is a fixed keyword; options follow
  :
}

_security_smartcards() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C -S \
    '1: :->subcmd' \
    '*:: :->args' && return 0

  case $state in
    (subcmd)
      local -a subcmds
      subcmds=('token:Enable disable or list disabled smartcard tokens')
      _describe -t subcmds 'smartcards command' subcmds
      ;;
    (args)
      case $words[1] in
        (token)
          _arguments -S \
            '-l[List disabled smartcard tokens]' \
            '-e[Enable specified token]:token' \
            '-d[Disable specified token]:token'
          ;;
      esac
      ;;
  esac
}

_security_translocate_policy_check() {
  _arguments -S \
    '1:path:_files'
}

_security_translocate_status_check() {
  _arguments -S \
    '1:path:_files'
}

_security_translocate_original_path() {
  _arguments -S \
    '1:path:_files'
}

_security_requirement_evaluate() {
  _arguments -S \
    '1:requirements' \
    '*:DER certificate file:_files'
}

_security_filevault() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C -S \
    '1: :->subcmd' \
    '*:: :->args' && return 0

  case $state in
    (subcmd)
      local -a subcmds
      subcmds=(
        'skip-sc-enforcement:Skip SmartCard enforcement for FileVault'
      )
      _describe -t subcmds 'filevault command' subcmds
      ;;
    (args)
      case $words[1] in
        (skip-sc-enforcement)
          _arguments -S \
            '1:data volume UUID' \
            '2:operation:(set reset status)'
          ;;
      esac
      ;;
  esac
}

_security_platformsso() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C -S \
    '1: :->subcmd' \
    '*:: :->args' && return 0

  case $state in
    (subcmd)
