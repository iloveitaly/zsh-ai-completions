_security() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C -S \
    '-h[Show help]' \
    '-i[Run in interactive mode]' \
    '-l[Run /usr/bin/leaks -nocontext before exiting]' \
    '-p[Set the prompt (implies -i)]:prompt' \
    '-q[Be less verbose]' \
    '-v[Be more verbose about what is going on]' \
    '1: :_security_commands' \
    '*:: :->args' && return 0

  case $state in
    (args)
      case $words[1] in
        (help) _security_help ;;
        (list-keychains) _security_list_keychains ;;
        (list-smartcards) _security_list_smartcards ;;
        (default-keychain) _security_default_keychain ;;
        (login-keychain) _security_login_keychain ;;
        (create-keychain) _security_create_keychain ;;
        (delete-keychain) _security_delete_keychain ;;
        (lock-keychain) _security_lock_keychain ;;
        (unlock-keychain) _security_unlock_keychain ;;
        (set-keychain-settings) _security_set_keychain_settings ;;
        (set-keychain-password) _security_set_keychain_password ;;
        (show-keychain-info) _security_show_keychain_info ;;
        (dump-keychain) _security_dump_keychain ;;
        (create-keypair) _security_create_keypair ;;
        (add-generic-password) _security_add_generic_password ;;
        (add-internet-password) _security_add_internet_password ;;
        (add-certificates) _security_add_certificates ;;
        (find-generic-password) _security_find_generic_password ;;
        (delete-generic-password) _security_delete_generic_password ;;
        (set-generic-password-partition-list) _security_set_generic_password_partition_list ;;
        (find-internet-password) _security_find_internet_password ;;
        (delete-internet-password) _security_delete_internet_password ;;
        (set-internet-password-partition-list) _security_set_internet_password_partition_list ;;
        (find-key) _security_find_key ;;
        (set-key-partition-list) _security_set_key_partition_list ;;
        (find-certificate) _security_find_certificate ;;
        (find-identity) _security_find_identity ;;
        (delete-certificate) _security_delete_certificate ;;
        (delete-identity) _security_delete_identity ;;
        (set-identity-preference) _security_set_identity_preference ;;
        (get-identity-preference) _security_get_identity_preference ;;
        (create-db) _security_create_db ;;
        (export) _security_export ;;
        (import) _security_import ;;
        (export-smartcard) _security_export_smartcard ;;
        (cms) _security_cms ;;
        (install-mds) _security_install_mds ;;
        (add-trusted-cert) _security_add_trusted_cert ;;
        (remove-trusted-cert) _security_remove_trusted_cert ;;
        (dump-trust-settings) _security_dump_trust_settings ;;
        (user-trust-settings-enable) _security_user_trust_settings_enable ;;
        (trust-settings-export) _security_trust_settings_export ;;
        (trust-settings-import) _security_trust_settings_import ;;
        (verify-cert) _security_verify_cert ;;
        (authorize) _security_authorize ;;
        (authorizationdb) _security_authorizationdb ;;
        (execute-with-privileges) _security_execute_with_privileges ;;
        (leaks) _security_leaks ;;
        (error) _security_error ;;
        (create-filevaultmaster-keychain) _security_create_filevaultmaster_keychain ;;
        (smartcards) _security_smartcards ;;
        (translocate-policy-check) _security_translocate_policy_check ;;
        (translocate-status-check) _security_translocate_status_check ;;
        (translocate-original-path) _security_translocate_original_path ;;
        (requirement-evaluate) _security_requirement_evaluate ;;
        (filevault) _security_filevault ;;
        (platformsso) _security_platformsso ;;
      esac
      ;;
  esac
}

_security "$@"
