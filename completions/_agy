#compdef agy

_agy_models() {
  local -a models
  models=(${(f)"$(agy models 2>/dev/null)"})
  _describe 'model' models
}

_agy_agents() {
  local -a agents
  agents=(${(f)"$(agy agent 2>/dev/null)"})
  _describe 'agent' agents
}

_agy_plugin_cmds() {
  local -a cmds
  cmds=(
    'list:List imported plugins'
    'import:Import plugins from gemini or claude'
    'install:Install a plugin'
    'uninstall:Uninstall a plugin'
    'enable:Enable a plugin'
    'disable:Disable a plugin'
    'validate:Validate a plugin'
    'link:Generate link to a marketplace'
    'help:Show help'
  )
  _describe 'plugin command' cmds
}

_agy_plugin() {
  local state
  _arguments -S \
    '1: :_agy_plugin_cmds' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        import)
          _arguments -S '1: :(gemini claude)'
          ;;
        install)
          _arguments -S '1: :_files'
          ;;
        validate)
          _arguments -S '1: :_files -/'
          ;;
        uninstall|enable|disable)
          _arguments -S '1: :'
          ;;
        link)
          _arguments -S '1: :' '2: :_files'
          ;;
        *)
          ;;
      esac
      ;;
  esac
}

_agy_subcommands() {
  local -a cmds
  cmds=(
    'agent:List available agents'
    'agents:List available agents'
    'changelog:Show changelog and release notes'
    'help:Show help for subcommands'
    'install:Configure environment paths and shell settings'
    'models:List available models'
    'plugin:Manage plugins'
    'plugins:Alias for plugin'
    'update:Update CLI'
  )
  _describe 'subcommand' cmds
}

_agy() {
  local state

  _arguments -S \
    '*--add-dir[Add a directory to the workspace (repeatable)]:directory:_files -/' \
    '--agent[Agent for the current CLI session]: :_agy_agents' \
    '-c[Short alias for --continue]' \
    '--continue[Continue the most recent conversation]' \
    '--conversation[Resume a previous conversation by ID]:conversation id:' \
    '--dangerously-skip-permissions[Auto-approve all tool permission requests without prompting]' \
    '--effort[Reasoning effort for the current CLI session]:effort:(low medium high)' \
    '-i[Short alias for --prompt-interactive]' \
    '--log-file[Override CLI log file path]:log file:_files' \
    '--mode[Set the agent execution mode for this session]:mode:(accept-edits plan)' \
    '--model[Model for the current CLI session]: :_agy_models' \
    '--new-project[Create a new project for this session]' \
    '-p[Short alias for --print]' \
    '--print[Run a single prompt non-interactively and print the response]:prompt:' \
    '--print-timeout[Timeout for print mode wait]:timeout:' \
    '--project[Project ID for the current CLI session]:project id:' \
    '--prompt[Alias for --print]:prompt:' \
    '--prompt-interactive[Run an initial prompt interactively and continue the session]:prompt:' \
    '--remote-control[Enable remote control mode]' \
    '--sandbox[Run in a sandbox with terminal restrictions enabled]' \
    '1: :_agy_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        agent|agents)
          _arguments -S \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
        changelog)
          _arguments -S \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
        install)
          _arguments -S \
            '--dir[Custom directory target to configure PATH for]:directory:_files -/' \
            '(-h --help)'{-h,--help}'[Show help]' \
            '--skip-aliases[Bypasses shell profile alias purging]' \
            '--skip-path[Bypasses shell profile PATH appending]'
          ;;
        models)
          _arguments -S \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
        plugin|plugins)
          _agy_plugin
          ;;
        update)
          _arguments -S
          ;;
        help)
          _arguments -S '1: :_agy_subcommands'
          ;;
        *)
          ;;
      esac
      ;;
  esac
}

_agy "$@"
