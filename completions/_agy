#compdef agy

_agy_models() {
  local -a models
  models=(${(f)"$(agy models 2>/dev/null)"})
  (( $#models )) && _describe -t models 'model' models
}

_agy_agents() {
  local -a agents
  agents=(${(f)"$(agy agent 2>/dev/null)"})
  agents=(${agents:#Available agents:})
  agents=(${agents:#})
  (( $#agents )) && _describe -t agents 'agent' agents
}

_agy_plugin_names() {
  local -a plugins
  plugins=(${(f)"$(agy plugin list 2>/dev/null)"})
  plugins=(${plugins:#No imported plugins.})
  plugins=(${plugins:#})
  (( $#plugins )) && _describe -t plugins 'plugin' plugins
}

_agy_commands() {
  local -a commands
  commands=(
    'agent:List available agents'
    'agents:List available agents'
    'changelog:Show changelog and release notes'
    'help:Show help for subcommands'
    'install:Configure environment paths and shell settings'
    'models:List available models'
    'plugin:Manage plugins'
    'plugins:Manage plugins'
    'update:Update CLI'
  )
  _describe -t commands 'command' commands
}

_agy_plugin_commands() {
  local -a commands
  commands=(
    'list:List imported plugins'
    'import:Import plugins from gemini or claude'
    'install:Install a plugin'
    'uninstall:Uninstall a plugin'
    'enable:Enable a plugin'
    'disable:Disable a plugin'
    'validate:Validate a plugin'
    'link:Generate link to a marketplace'
    'help:Show this help'
  )
  _describe -t commands 'plugin command' commands
}

_agy_agent() {
  _arguments -S \
    '(-h --help)'{-h,--help}'[Show help]'
}

_agy_changelog() {
  _arguments -S \
    '(-h --help)'{-h,--help}'[Show help]'
}

_agy_help() {
  _arguments -S \
    '1:subcommand:_agy_commands'
}

_agy_install() {
  _arguments -S \
    '--dir[Custom directory target to configure PATH for]:directory:_files -/' \
    '--skip-aliases[Bypasses shell profile alias purging]' \
    '--skip-path[Bypasses shell profile PATH appending]' \
    '(-h --help)'{-h,--help}'[Show help]'
}

_agy_models_cmd() {
  _arguments -S \
    '(-h --help)'{-h,--help}'[Show help]'
}

_agy_update() {
  _arguments -S
}

_agy_plugin() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -S \
    '1: :_agy_plugin_commands' \
    '*:: :->args' && return 0

  case $state in
    args)
      case $words[1] in
        list|help)
          ;;
        import)
          _arguments -S \
            '1:source:(gemini claude)'
          ;;
        install)
          _arguments -S \
            '1:target:_files -/'
          ;;
        uninstall|enable|disable)
          _arguments -S \
            '1:name:_agy_plugin_names'
          ;;
        validate)
          _arguments -S \
            '1:path:_files -/'
          ;;
        link)
          _arguments -S \
            '1:marketplace:' \
            '2:target:'
          ;;
      esac
      ;;
  esac
}

_agy() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -S \
    '*--add-dir[Add a directory to the workspace]:directory:_files -/' \
    '--agent[Agent for the current CLI session]:agent:_agy_agents' \
    '(-c --continue)'{-c,--continue}'[Continue the most recent conversation]' \
    '--conversation[Resume a previous conversation by ID]:conversation id' \
    '--dangerously-skip-permissions[Auto-approve all tool permission requests without prompting]' \
    '--effort[Reasoning effort for the current CLI session]:effort:(low medium high)' \
    '(-i --prompt-interactive)'{-i,--prompt-interactive}'[Run an initial prompt interactively and continue the session]:prompt' \
    '--log-file[Override CLI log file path]:file:_files' \
    '--mode[Set the agent execution mode for this session]:mode:(accept-edits plan)' \
    '--model[Model for the current CLI session]:model:_agy_models' \
    '--new-project[Create a new project for this session]' \
    '(-p --print --prompt)'{-p,--print,--prompt}'[Run a single prompt non-interactively and print the response]:prompt' \
    '--print-timeout[Timeout for print mode wait]:timeout' \
    '--project[Project ID for the current CLI session]:project id' \
    '--sandbox[Run in a sandbox with terminal restrictions enabled]' \
    '1: :_agy_commands' \
    '*:: :->args' && return 0

  case $state in
    args)
      case $words[1] in
        agent|agents)
          _agy_agent
          ;;
        changelog)
          _agy_changelog
          ;;
        help)
          _agy_help
          ;;
        install)
          _agy_install
          ;;
        models)
          _agy_models_cmd
          ;;
        plugin|plugins)
          _agy_plugin
          ;;
        update)
          _agy_update
          ;;
      esac
      ;;
  esac
}

_agy "$@"
