_hunk_session_comment_add() {
  _arguments -S \
    '--file[diff file path as shown by Hunk]:path:_files' \
    '--summary[short review note]:text:' \
    '--repo[target session by repo root]:path:_files -/' \
    '--old-line[1-based line number on the old side]:n:' \
    '--new-line[1-based line number on the new side]:n:' \
    '--rationale[optional longer explanation]:text:' \
    '--author[optional author label]:name:' \
    '--focus[add the note and focus the viewport on it]' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_comment_apply() {
  _arguments -S \
    '--repo[target session by repo root]:path:_files -/' \
    '--stdin[read the comment batch from stdin as JSON]' \
    '--focus[apply the batch and focus the first note]' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_comment_list() {
  _arguments -S \
    '--repo[target session by repo root]:path:_files -/' \
    '--file[filter comments to one diff file]:path:_files' \
    '--type[filter comment type]:type:(live all ai agent user)' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
