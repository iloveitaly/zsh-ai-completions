    '--file[diff file path as shown by Hunk]:path:_files' \
    '--repo[target session by repo root]:path:_files -/' \
    '--hunk[1-based hunk number within the file]:n:' \
    '--old-line[1-based line number on the old side]:n:' \
    '--new-line[1-based line number on the new side]:n:' \
    '--next-comment[jump to the next annotated hunk]' \
    '--prev-comment[jump to the previous annotated hunk]' \
