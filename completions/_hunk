#compdef hunk

# Shared review options used by diff/show/patch/pager/difftool
_hunk_review_opts() {
  local -a opts
  opts=(
    '--mode[layout mode]:mode:(auto split stack)'
    '--theme[named theme override]:theme:'
    '--agent-context[JSON sidecar with agent rationale]:path:_files'
    '--pager[use pager-style chrome and controls]'
    '--line-numbers[show line numbers]'
    '--no-line-numbers[hide line numbers]'
    '--wrap[wrap long diff lines]'
    '--no-wrap[truncate long diff lines to one row]'
    '--hunk-headers[show hunk metadata rows]'
    '--no-hunk-headers[hide hunk metadata rows]'
    '--agent-notes[show agent notes by default]'
    '--no-agent-notes[hide agent notes by default]'
    '--transparent-bg[let terminal background show through]'
    '--no-transparent-bg[paint surfaces with the active theme]'
    '(-h --help)'{-h,--help}'[display help for command]'
  )
  _values -w 'options' $opts
}

_hunk_commands() {
  local -a commands
  commands=(
    'diff:review working tree changes or compare targets/files'
    'show:review the last commit or a given target'
    'stash:review a stash entry (git only)'
    'patch:review a patch file or stdin'
    'pager:general Git pager wrapper with diff detection'
    'difftool:review Git difftool file pairs'
    'session:inspect or control a live Hunk session'
    'skill:print the bundled Hunk review skill path'
    'daemon:run the local Hunk session daemon'
  )
  _describe -t commands 'hunk command' commands
}

_hunk_session_commands() {
  local -a commands
  commands=(
    'list:list live Hunk sessions'
    'get:show one live Hunk session'
    'context:show the selected file and hunk for one session'
    'review:export the live review model for one session'
    'navigate:move a live session to one diff hunk'
    'reload:replace the contents of one live session'
    'comment:manage live inline review notes'
  )
  _describe -t commands 'session command' commands
}

_hunk_session_comment_commands() {
  local -a commands
  commands=(
    'add:attach one live inline review note'
    'apply:apply many live notes from stdin JSON'
    'list:list live inline review notes'
    'rm:remove one inline review note'
    'clear:clear inline review notes'
  )
  _describe -t commands 'comment command' commands
}

_hunk_skill_commands() {
  local -a commands
  commands=(
    'path:print the bundled Hunk review skill path'
  )
  _describe -t commands 'skill command' commands
}

_hunk_daemon_commands() {
  local -a commands
  commands=(
    'serve:run the local Hunk session daemon'
  )
  _describe -t commands 'daemon command' commands
}

_hunk_stash_commands() {
  local -a commands
  commands=(
    'show:review a stash entry as a full Hunk changeset'
  )
  _describe -t commands 'stash command' commands
}

_hunk_diff() {
  _arguments -S \
    '--mode[layout mode]:mode:(auto split stack)' \
    '--theme[named theme override]:theme:' \
    '--agent-context[JSON sidecar with agent rationale]:path:_files' \
    '--pager[use pager-style chrome and controls]' \
    '--line-numbers[show line numbers]' \
    '--no-line-numbers[hide line numbers]' \
    '--wrap[wrap long diff lines]' \
    '--no-wrap[truncate long diff lines to one row]' \
    '--hunk-headers[show hunk metadata rows]' \
    '--no-hunk-headers[hide hunk metadata rows]' \
    '--agent-notes[show agent notes by default]' \
    '--no-agent-notes[hide agent notes by default]' \
    '--transparent-bg[let terminal background show through]' \
    '--no-transparent-bg[paint surfaces with the active theme]' \
    '--watch[auto-reload when the current diff input changes]' \
    '(--cached)--staged[show staged changes instead of the working tree]' \
    '(--staged)--cached[alias for --staged]' \
    '--exclude-untracked[exclude untracked files from working tree reviews]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '*:target or path:_files'
}

_hunk_show() {
  _arguments -S \
    '--mode[layout mode]:mode:(auto split stack)' \
    '--theme[named theme override]:theme:' \
    '--agent-context[JSON sidecar with agent rationale]:path:_files' \
    '--pager[use pager-style chrome and controls]' \
    '--line-numbers[show line numbers]' \
    '--no-line-numbers[hide line numbers]' \
    '--wrap[wrap long diff lines]' \
    '--no-wrap[truncate long diff lines to one row]' \
    '--hunk-headers[show hunk metadata rows]' \
    '--no-hunk-headers[hide hunk metadata rows]' \
    '--agent-notes[show agent notes by default]' \
    '--no-agent-notes[hide agent notes by default]' \
    '--transparent-bg[let terminal background show through]' \
    '--no-transparent-bg[paint surfaces with the active theme]' \
    '--watch[auto-reload when the current diff input changes]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:ref: '
}

_hunk_stash() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -S \
    '1: :_hunk_stash_commands' \
    '*:: :->args' && return

  case $state in
    args)
      case $words[1] in
        show)
          _arguments -S \
            '(-h --help)'{-h,--help}'[display help for command]' \
            '1:stash ref: '
          ;;
      esac
      ;;
  esac
}

