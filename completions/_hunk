    '--repo[target session by repo root]:path:_files -/' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_context() {
  _arguments -S \
    '--repo[target session by repo root]:path:_files -/' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_review() {
  _arguments -S \
    '--repo[target session by repo root]:path:_files -/' \
    '--json[emit structured JSON]' \
    '--include-patch[include raw unified diff text for each file]' \
    '--include-notes[include live review notes]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
