_hunk_session_comment_add() {
  _arguments -S \
    '--file[diff file path as shown by Hunk]:path:_files' \
    '--summary[short review note]:text:' \
    '--repo[target the live session whose repo root matches this path]:path:_files -/' \
    '--old-line[1-based line number on the old side]:n:' \
    '--new-line[1-based line number on the new side]:n:' \
    '--rationale[optional longer explanation]:text:' \
    '--author[optional author label]:name:' \
    '--focus[add the note and focus the viewport on it]' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_comment_apply() {
  _arguments -S \
    '--repo[target the live session whose repo root matches this path]:path:_files -/' \
    '--stdin[read the comment batch from stdin as JSON]' \
    '--focus[apply the batch and focus the first note]' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_comment_list() {
  _arguments -S \
    '--repo[target the live session whose repo root matches this path]:path:_files -/' \
    '--file[filter comments to one diff file]:path:_files' \
    '--type[filter comment type]:type:_hunk_comment_types' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_comment_rm() {
  _arguments -S \
    '--repo[target the live session whose repo root matches this path]:path:_files -/' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '*:session-id or comment-id: '
}

_hunk_session_comment_clear() {
  _arguments -S \
    '--repo[target the live session whose repo root matches this path]:path:_files -/' \
    '--file[clear only one diff file comments]:path:_files' \
    '(--all)--include-user[also clear human notes created with the TUI c action]' \
    '(--include-user)--all[clear both live agent comments and human user notes]' \
    '--yes[confirm destructive comment clearing]' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_comment() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C -S \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1: :_hunk_session_comment_commands' \
    '*:: :->args' && return

  case $state in
    (args)
      case $line[1] in
        (add) _hunk_session_comment_add ;;
        (apply) _hunk_session_comment_apply ;;
        (list) _hunk_session_comment_list ;;
        (rm) _hunk_session_comment_rm ;;
        (clear) _hunk_session_comment_clear ;;
      esac
      ;;
  esac
}

_hunk_session() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C -S \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1: :_hunk_session_commands' \
    '*:: :->args' && return

  case $state in
    (args)
      case $line[1] in
        (list)
          _arguments -S \
            '--json[emit structured JSON]' \
            '(-h --help)'{-h,--help}'[display help for command]'
          ;;
        (get)
          _arguments -S \
            '--repo[target the live session whose repo root matches this path]:path:_files -/' \
            '--json[emit structured JSON]' \
            '(-h --help)'{-h,--help}'[display help for command]' \
            '1:session-id: '
          ;;
        (context)
          _arguments -S \
            '--repo[target the live session whose repo root matches this path]:path:_files -/' \
            '--json[emit structured JSON]' \
            '(-h --help)'{-h,--help}'[display help for command]' \
            '1:session-id: '
          ;;
        (review)
          _arguments -S \
            '--repo[target the live session whose repo root matches this path]:path:_files -/' \
            '--json[emit structured JSON]' \
            '--include-patch[include raw unified diff text for each file in review output]' \
            '--include-notes[include live review notes in review output]' \
            '(-h --help)'{-h,--help}'[display help for command]' \
            '1:session-id: '
          ;;
        (navigate)
          _arguments -S \
            '--file[diff file path as shown by Hunk]:path:_files' \
            '--repo[target the live session whose repo root matches this path]:path:_files -/' \
            '--hunk[1-based hunk number within the file]:n:' \
            '--old-line[1-based line number on the old side]:n:' \
            '--new-line[1-based line number on the new side]:n:' \
            '--next-comment[jump to the next annotated hunk]' \
            '--prev-comment[jump to the previous annotated hunk]' \
            '--json[emit structured JSON]' \
            '(-h --help)'{-h,--help}'[display help for command]' \
            '1:session-id: '
          ;;
        (reload)
          _arguments -S \
            '--repo[target the live session whose repo root matches this path]:path:_files -/' \
            '--session-path[target a live session rooted at a different path]:path:_files -/' \
            '--source[load the diff from this directory instead of the session own]:path:_files -/' \
            '--json[emit structured JSON]' \
            '(-h --help)'{-h,--help}'[display help for command]' \
            '1:session-id: ' \
            '*:reload args: '
          ;;
        (comment)
          _hunk_session_comment
          ;;
      esac
      ;;
  esac
}

_hunk_skill() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C -S \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1: :_hunk_skill_commands' \
    '*:: :->args' && return
}

_hunk_daemon() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C -S \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1: :_hunk_daemon_commands' \
    '*:: :->args' && return
}

_hunk() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C -S \
    '(-h --help)'{-h,--help}'[show help]' \
    '(-v --version)'{-v,--version}'[show version]' \
    '1: :_hunk_commands' \
    '*:: :->args' && return

  case $state in
    (args)
      case $line[1] in
        (diff) _hunk_diff ;;
        (show) _hunk_show ;;
        (stash) _hunk_stash ;;
        (patch) _hunk_patch ;;
        (pager) _hunk_pager ;;
        (difftool) _hunk_difftool ;;
        (session) _hunk_session ;;
        (skill) _hunk_skill ;;
        (daemon) _hunk_daemon ;;
      esac
      ;;
  esac
}

_hunk "$@"
