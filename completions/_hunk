_hunk_difftool() {
  _arguments -S \
    '--mode[layout mode: auto, split, stack]:mode:_hunk_modes' \
    '--theme[named theme override]:theme:' \
    '--agent-context[JSON sidecar with agent rationale]:path:_files' \
    '--pager[use pager-style chrome and controls]' \
    '(--no-line-numbers)--line-numbers[show line numbers]' \
    '(--line-numbers)--no-line-numbers[hide line numbers]' \
    '(--no-wrap)--wrap[wrap long diff lines]' \
    '(--wrap)--no-wrap[truncate long diff lines to one row]' \
    '(--no-hunk-headers)--hunk-headers[show hunk metadata rows]' \
    '(--hunk-headers)--no-hunk-headers[hide hunk metadata rows]' \
