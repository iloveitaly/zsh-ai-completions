#compdef hunk


_hunk_modes() {
  local -a modes
  modes=(
    'auto:choose layout automatically'
    'split:side by side layout'
    'stack:stacked layout'
  )
  _describe -t modes 'layout mode' modes
}

_hunk_comment_types() {
  local -a types
  types=(
    'live:live comments'
    'all:all comments'
    'ai:AI comments'
    'agent:agent comments'
    'user:user comments'
  )
  _describe -t types 'comment type' types
}

_hunk_common_review_opts() {
  # Shared options for review-style subcommands. Caller may append more.
  print -r -- \
    '--mode[layout mode: auto, split, stack]:mode:_hunk_modes' \
    '--theme[named theme override]:theme:' \
    '--agent-context[JSON sidecar with agent rationale]:path:_files' \
    '--pager[use pager-style chrome and controls]' \
    '(--no-line-numbers)--line-numbers[show line numbers]' \
    '(--line-numbers)--no-line-numbers[hide line numbers]' \
    '(--no-wrap)--wrap[wrap long diff lines]' \
    '(--wrap)--no-wrap[truncate long diff lines to one row]' \
    '(--no-hunk-headers)--hunk-headers[show hunk metadata rows]' \
    '(--hunk-headers)--no-hunk-headers[hide hunk metadata rows]' \
    '(--no-agent-notes)--agent-notes[show agent notes by default]' \
    '(--agent-notes)--no-agent-notes[hide agent notes by default]' \
    '(--no-transparent-bg)--transparent-bg[let terminal background show through Hunk surfaces]' \
    '(--transparent-bg)--no-transparent-bg[paint Hunk surfaces with the active theme]' \
    '(-h --help)'{-h,--help}'[display help for command]'
}

_hunk_commands() {
  local -a commands
  commands=(
    'diff:review working tree changes or compare targets'
    'show:review the last commit or a given target'
    'stash:review a stash entry (git only)'
    'patch:review a patch file or stdin'
    'pager:general Git pager wrapper with diff detection'
    'difftool:review Git difftool file pairs'
    'session:inspect or control a live Hunk session'
    'skill:print the bundled Hunk review skill path'
    'daemon:run the local Hunk session daemon'
  )
  _describe -t commands 'hunk command' commands
}

_hunk_session_commands() {
  local -a commands
  commands=(
    'list:list live Hunk sessions'
    'get:show one live Hunk session'
    'context:show the selected file and hunk for one live session'
    'review:export the live review model for one session'
    'navigate:move a live session to one diff hunk'
    'reload:replace the contents of one live session'
    'comment:manage live inline review notes'
  )
  _describe -t commands 'session subcommand' commands
}

_hunk_session_comment_commands() {
  local -a commands
  commands=(
    'add:attach one live inline review note'
    'apply:apply many live inline review notes from stdin JSON'
    'list:list live inline review notes'
    'rm:remove one inline review note'
    'clear:clear inline review notes'
  )
  _describe -t commands 'comment subcommand' commands
}

_hunk_skill_commands() {
  local -a commands
  commands=(
    'path:print the bundled Hunk review skill path'
  )
  _describe -t commands 'skill subcommand' commands
}

_hunk_daemon_commands() {
  local -a commands
  commands=(
    'serve:run the local Hunk session daemon'
  )
  _describe -t commands 'daemon subcommand' commands
}

_hunk_stash_commands() {
  local -a commands
  commands=(
    'show:review a stash entry as a full Hunk changeset'
  )
  _describe -t commands 'stash subcommand' commands
}

_hunk_diff() {
  _arguments -S \
    '--mode[layout mode: auto, split, stack]:mode:_hunk_modes' \
    '--theme[named theme override]:theme:' \
    '--agent-context[JSON sidecar with agent rationale]:path:_files' \
    '--pager[use pager-style chrome and controls]' \
    '(--no-line-numbers)--line-numbers[show line numbers]' \
    '(--line-numbers)--no-line-numbers[hide line numbers]' \
    '(--no-wrap)--wrap[wrap long diff lines]' \
    '(--wrap)--no-wrap[truncate long diff lines to one row]' \
    '(--no-hunk-headers)--hunk-headers[show hunk metadata rows]' \
    '(--hunk-headers)--no-hunk-headers[hide hunk metadata rows]' \
    '(--no-agent-notes)--agent-notes[show agent notes by default]' \
    '(--agent-notes)--no-agent-notes[hide agent notes by default]' \
    '(--no-transparent-bg)--transparent-bg[let terminal background show through Hunk surfaces]' \
    '(--transparent-bg)--no-transparent-bg[paint Hunk surfaces with the active theme]' \
    '--watch[auto-reload when the current diff input changes]' \
    '(--cached)--staged[show staged changes instead of the working tree]' \
    '(--staged)--cached[alias for --staged]' \
    '--exclude-untracked[exclude untracked files from working tree reviews]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '*:target or path:_files'
}

_hunk_show() {
  _arguments -S \
    '--mode[layout mode: auto, split, stack]:mode:_hunk_modes' \
    '--theme[named theme override]:theme:' \
    '--agent-context[JSON sidecar with agent rationale]:path:_files' \
    '--pager[use pager-style chrome and controls]' \
    '(--no-line-numbers)--line-numbers[show line numbers]' \
    '(--line-numbers)--no-line-numbers[hide line numbers]' \
    '(--no-wrap)--wrap[wrap long diff lines]' \
    '(--wrap)--no-wrap[truncate long diff lines to one row]' \
    '(--no-hunk-headers)--hunk-headers[show hunk metadata rows]' \
    '(--hunk-headers)--no-hunk-headers[hide hunk metadata rows]' \
    '(--no-agent-notes)--agent-notes[show agent notes by default]' \
    '(--agent-notes)--no-agent-notes[hide agent notes by default]' \
    '(--no-transparent-bg)--transparent-bg[let terminal background show through Hunk surfaces]' \
    '(--transparent-bg)--no-transparent-bg[paint Hunk surfaces with the active theme]' \
    '--watch[auto-reload when the current diff input changes]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:ref: '
}

_hunk_stash() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C -S \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1: :_hunk_stash_commands' \
    '*:: :->args' && return

  case $state in
    (args)
      case $line[1] in
        (show)
          _arguments -S \
            '(-h --help)'{-h,--help}'[display help for command]' \
            '1:stash ref: '
          ;;
      esac
      ;;
  esac
}

