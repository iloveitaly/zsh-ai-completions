}

_hunk_session_comment_clear() {
  _arguments -S \
    '--repo[target session by repo root]:path:_files -/' \
    '--file[clear only one diff file'''s comments]:path:_files' \
    '(--all)--include-user[also clear human notes from TUI c action]' \
    '(--include-user)--all[clear both live agent comments and human notes]' \
    '--yes[confirm destructive comment clearing]' \
    '--json[emit structured JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:session-id: '
}

_hunk_session_comment() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -S \
    '1: :_hunk_session_comment_commands' \
    '*:: :->args' && return

  case $state in
    args)
      case $words[1] in
        add)   _hunk_session_comment_add ;;
        apply) _hunk_session_comment_apply ;;
        list)  _hunk_session_comment_list ;;
        rm)    _hunk_session_comment_rm ;;
        clear) _hunk_session_comment_clear ;;
      esac
      ;;
  esac
}

_hunk_session() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -S \
    '1: :_hunk_session_commands' \
    '*:: :->args' && return

  case $state in
    args)
      case $words[1] in
        list)     _hunk_session_list ;;
        get)      _hunk_session_get ;;
        context)  _hunk_session_context ;;
        review)   _hunk_session_review ;;
        navigate) _hunk_session_navigate ;;
        reload)   _hunk_session_reload ;;
        comment)  _hunk_session_comment ;;
      esac
      ;;
  esac
}

_hunk_skill() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -S \
    '1: :_hunk_skill_commands' \
    '*:: :->args' && return

  case $state in
    args)
      case $words[1] in
        path)
          _arguments -S \
            '(-h --help)'{-h,--help}'[display help for command]'
          ;;
      esac
      ;;
  esac
}

_hunk_daemon() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -S \
    '1: :_hunk_daemon_commands' \
    '*:: :->args' && return

  case $state in
    args)
      case $words[1] in
        serve)
          _arguments -S \
            '(-h --help)'{-h,--help}'[display help for command]'
          ;;
      esac
      ;;
  esac
}

_hunk() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -S \
    '(-h --help)'{-h,--help}'[show help]' \
    '(-v --version)'{-v,--version}'[show version]' \
    '1: :_hunk_commands' \
    '*:: :->args' && return

  case $state in
    args)
      case $words[1] in
        diff)     _hunk_diff ;;
        show)     _hunk_show ;;
        stash)    _hunk_stash ;;
        patch)    _hunk_patch ;;
        pager)    _hunk_pager ;;
        difftool) _hunk_difftool ;;
        session)  _hunk_session ;;
        skill)    _hunk_skill ;;
        daemon)   _hunk_daemon ;;
      esac
      ;;
  esac
}

_hunk "$@"
